# ============================================================
# 花都校区定制壁纸切换 - Git 忽略规则
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# ---------- 虚拟环境 ----------
# venv 里自带 *.gitignore 也能挡住，这里再显式写一遍
venv/
.venv/
env/
ENV/

# ---------- PyInstaller 打包产物 ----------
# 每次执行 --clean 都会重新生成，不需要进仓库
build/
dist/
*.spec

# ---------- 运行时生成 ----------
*.log
run.log

# config.json 是随仓库分发的默认配置（打包时 auto_install 要复制它），
# 所以默认不忽略。如果以后只想在本地保留自己的路径，
# 执行 git rm --cached config.json 后再取消下面一行的注释。
# config.json

# ---------- 编辑器 / 系统 ----------
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store
